{
  "manifest_version": 3,
  "name": "PR Sidebar",
  "version": "1.3",
  "description": "Lists your open GitHub pull requests in the Chrome side panel. Talks only to api.github.com with a read-only token.",
  "permissions": [
    "storage",
    "tabs",
    "sidePanel"
  ],
  "host_permissions": [
    "https://api.github.com/*"
  ],
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_title": "Open PRs"
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "background": {
    "service_worker": "background.js"
  }
}
